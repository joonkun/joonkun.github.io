---
import { getCollection } from "astro:content";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { categoryHref, getFeatured, postHref, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const featured = getFeatured(allPosts, 3);
const notes = allPosts.filter((post) => post.data.category === "노트").slice(0, 5);
const essays = allPosts.filter((post) => post.data.category !== "노트" && !post.data.featured).slice(0, 5);
const lead = featured[0];
---

<BaseLayout>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="inner">
      <section class="intro" aria-labelledby="intro-title">
        <p class="meta"><span class="meta-accent">AI Product Manager, Adriel</span></p>
        <h1 id="intro-title" class="intro-title">안녕하세요, Joon입니다.</h1>
        <p class="intro-lede">
          고객 현장에서 반복되는 문제를 찾아 제품으로 푸는 AI PM입니다. 최근에는 일본 최대 고객의 맞춤 요구를 모든 고객이 쓰는 기능으로 바꿔, 그 고객의 ARR을 약 7배로 키웠습니다.
          {lead && <>{" "}그 과정은 <a href={postHref(lead)}>이 글</a>에 썼습니다.</>}
        </p>
      </section>

      <div class="grid gap-[var(--space-section)] lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
        <div class="grid gap-[var(--space-section)] content-start">
          {featured.length > 0 && (
            <section aria-labelledby="featured-heading">
              <h2 id="featured-heading" class="section-title">대표 글</h2>
              <div class="feed">
                {featured.map((post) => <PostCard post={post} />)}
              </div>
            </section>
          )}

          {essays.length > 0 && (
            <section aria-labelledby="essays-heading">
              <h2 id="essays-heading" class="section-title">최근 글</h2>
              <div class="feed">
                {essays.map((post) => <PostCard post={post} />)}
              </div>
            </section>
          )}

          {notes.length > 0 && (
            <section aria-labelledby="notes-heading">
              <h2 id="notes-heading" class="section-title">노트</h2>
              <div class="grid gap-7">
                {notes.map((post) => <PostCard post={post} variant="compact" headingLevel="h3" />)}
              </div>
              <a href={categoryHref("노트")} class="btn btn-outline btn-block mt-12">노트 모두 보기</a>
            </section>
          )}
        </div>

        <aside class="sidebar">
          <section aria-labelledby="about-heading">
            <h2 id="about-heading" class="section-title">소개</h2>
            <p class="text-lg font-semibold tracking-tight">Joon (허재준)</p>
            <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{siteConfig.about}</p>
            <p class="mt-3 text-sm"><a href="/about/" class="link-quiet underline underline-offset-2">더 알아보기</a> · <a href={`mailto:${siteConfig.email}`} class="link-quiet underline underline-offset-2">메일 보내기</a></p>
            {siteConfig.newsletter.action && (
              <div class="mt-7 border-t border-border pt-6">
                <NewsletterSignup />
              </div>
            )}
          </section>
        </aside>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .intro {
    padding: 2.5rem 0 var(--space-section);
    max-width: 46rem;
  }
  @media (min-width: 768px) {
    .intro { padding-top: 3.5rem; }
  }
  .intro-title {
    margin: 1rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .intro-lede {
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--foreground) 88%, transparent);
    text-wrap: pretty;
  }
  .intro-lede a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
