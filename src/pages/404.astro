---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="페이지를 찾을 수 없음" description="요청한 페이지를 찾을 수 없습니다." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">404</p>
      <h1 class="pagehead-title">페이지를 찾을 수 없습니다</h1>
      <p class="pagehead-description mx-auto">
        글이 옮겨졌거나 주소가 잘못되었을 수 있습니다.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">처음으로</a>
        <a href="/posts/" class="btn btn-outline">모든 글 보기</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
